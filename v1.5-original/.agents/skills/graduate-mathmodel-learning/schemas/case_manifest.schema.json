{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "year",
    "problem_id",
    "canonical_working_title",
    "title_status",
    "problem_assets",
    "excellent_papers",
    "first_pass_requirements",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "problem_id": {
      "type": "string"
    },
    "canonical_working_title": {
      "type": "string"
    },
    "title_status": {
      "enum": [
        "confirmed",
        "conflicted",
        "unverified",
        "resolved"
      ]
    },
    "title_variants": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "problem_assets": {
      "type": "array",
      "minItems": 1
    },
    "excellent_papers": {
      "type": "array",
      "minItems": 2
    },
    "supplementary_material": {
      "type": "array"
    },
    "method_family_expectations": {
      "type": "object"
    },
    "first_pass_requirements": {
      "type": "object"
    },
    "status": {
      "type": "string"
    },
    "paper_screening": {
      "type": "object"
    }
  }
}